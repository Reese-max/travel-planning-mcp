# REST API bind settings
HOST=127.0.0.1
PORT=8787

# Optional on loopback; REQUIRED when HOST is not a loopback address.
# Used as: Authorization: Bearer <TRAVEL_API_KEY>
TRAVEL_API_KEY=replace-with-a-long-random-read-write-key

# Required to enable approve/reject/apply/rollback REST endpoints.
# Used as: X-Approval-Key: <APPROVAL_API_KEY>
# Keep this separate from TRAVEL_API_KEY so an AI/client token cannot self-approve.
APPROVAL_API_KEY=replace-with-a-different-long-random-approval-key

# MCP administrative rollback stays disabled unless an operator explicitly enables it.
ENABLE_ADMIN_MCP_WRITES=false

# Travel data providers. Defaults to demo providers when omitted.
# Set either or both to "google" to use live Google Maps Platform data.
PLACE_PROVIDER=demo
ROUTE_PROVIDER=demo

# Required when PLACE_PROVIDER=google or ROUTE_PROVIDER=google.
# Enable Places API (New) and/or Routes API for the same Google Cloud project.
GOOGLE_MAPS_API_KEY=
