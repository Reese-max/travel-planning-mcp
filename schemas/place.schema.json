{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planning-mcp.dev/schemas/place.schema.json",
  "title": "Place",
  "type": "object",
  "required": ["place_id", "name", "location", "categories", "source"],
  "properties": {
    "place_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "localized_names": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "location": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "address": { "type": ["string", "null"] },
        "country_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "timezone": { "type": ["string", "null"], "description": "IANA timezone, for example Asia/Tokyo." }
      },
      "additionalProperties": false
    },
    "external_ids": {
      "type": "object",
      "properties": {
        "google_place_id": { "type": ["string", "null"] },
        "osm_id": { "type": ["string", "null"] },
        "tdx_id": { "type": ["string", "null"] }
      },
      "additionalProperties": { "type": ["string", "null"] }
    },
    "opening_hours": {
      "type": ["object", "null"],
      "properties": {
        "timezone": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["day", "open", "close"],
            "properties": {
              "day": { "type": "integer", "minimum": 0, "maximum": 6 },
              "open": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
              "close": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "properties": {
        "recommended_duration_minutes": { "type": ["integer", "null"], "minimum": 0 },
        "indoor": { "type": ["boolean", "null"] },
        "reservation_required": { "type": ["boolean", "null"] },
        "accessibility": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "estimated_cost": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["amount", "currency"],
              "properties": {
                "amount": { "type": "number", "minimum": 0 },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "user_metadata": {
      "type": "object",
      "properties": {
        "priority": { "enum": ["must_visit", "high", "normal", "low", "avoid"] },
        "visited": { "type": "boolean" },
        "favorite": { "type": "boolean" },
        "notes": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "source_id": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
