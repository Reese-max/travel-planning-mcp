{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planning-mcp.dev/schemas/trip.schema.json",
  "title": "Trip",
  "type": "object",
  "required": ["trip_id", "version", "title", "start_date", "end_date", "status", "travelers", "days", "created_at", "updated_at"],
  "properties": {
    "trip_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "status": { "enum": ["draft", "planned", "active", "completed", "archived"] },
    "travelers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["traveler_id", "display_name", "role"],
        "properties": {
          "traveler_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["owner", "editor", "traveler"] }
        },
        "additionalProperties": false
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "pace": { "enum": ["relaxed", "balanced", "intensive"] },
        "interests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "preferred_transport": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["walking", "transit", "rail", "taxi", "car", "bike"] }
        }
      },
      "additionalProperties": true
    },
    "place_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "reservation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "constraint_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "items"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "base_place_id": { "type": ["string", "null"], "format": "uuid" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item_id", "type", "locked"],
              "properties": {
                "item_id": { "type": "string", "format": "uuid" },
                "type": { "enum": ["place", "reservation", "transit", "meal", "free_time", "note"] },
                "place_id": { "type": ["string", "null"], "format": "uuid" },
                "reservation_id": { "type": ["string", "null"], "format": "uuid" },
                "title": { "type": ["string", "null"] },
                "start_at": { "type": ["string", "null"], "format": "date-time" },
                "end_at": { "type": ["string", "null"], "format": "date-time" },
                "duration_minutes": { "type": ["integer", "null"], "minimum": 0 },
                "locked": { "type": "boolean" },
                "notes": { "type": ["string", "null"] },
                "route": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["mode", "duration_minutes", "distance_meters"],
                      "properties": {
                        "mode": { "enum": ["walking", "transit", "rail", "taxi", "car", "bike"] },
                        "duration_minutes": { "type": "integer", "minimum": 0 },
                        "distance_meters": { "type": "integer", "minimum": 0 },
                        "source": { "type": ["string", "null"] },
                        "calculated_at": { "type": ["string", "null"], "format": "date-time" }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "source_timing": {
                  "description": "Provider-reported local timing kept as provenance; never an absolute instant.",
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["provider", "source_id", "local_date", "local_time", "timezone"],
                      "properties": {
                        "provider": { "type": "string" },
                        "source_id": { "type": "string" },
                        "local_date": { "type": ["string", "null"], "format": "date" },
                        "local_time": { "type": ["string", "null"] },
                        "timezone": { "type": ["string", "null"] }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "change_proposal_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "import_source": {
      "description": "Provenance of a trip created by an explicitly approved external import.",
      "type": ["object", "null"],
      "required": [
        "provider",
        "source_trip_id",
        "source_fingerprint",
        "live",
        "imported_at",
        "imported_by",
        "approved_by",
        "approved_at",
        "approval_channel"
      ],
      "properties": {
        "provider": { "type": "string" },
        "instance_id": { "type": ["string", "null"] },
        "source_trip_id": { "type": "string" },
        "source_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "live": { "type": "boolean" },
        "preview_retrieved_at": { "type": ["string", "null"], "format": "date-time" },
        "imported_at": { "type": "string", "format": "date-time" },
        "imported_by": { "type": "string" },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "approval_channel": { "enum": ["http", "admin", "ui"] },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
